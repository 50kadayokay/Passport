node_modules/
.node/
dist/
*.log
.DS_Store

# Local env / secrets — never commit
.env
.env.*
!.env.example

# Large reference artifact (11.8MB compiled HTML design source)
Passport_ai_brief__1_.html
.vercel
.env*

# secrets & local-only cruft — never commit
companies/keys.env
backups/
__acct.*

# Worktree symlinks to the main checkout (the trailing-slash patterns above do not
# match a symlink, so these showed as untracked and could be committed by accident).
/.node
/node_modules

# Agent/working scratch — screenshots, probe scripts, .bak files. Never shipped.
scratchpad/

# Conference booth attract loop — a single 160MB video, above GitHub's 100MB
# per-file hard limit, so it cannot live here. ConferenceV3Booth falls back to
# /conference-media/<slug>/attract.mp4, so upload it to the deploy target (or set
# profile.conference.attractVideo to a hosted URL) for the booth's attract loop.
# The public marketing site does not use it.
public/conference-media/

# Staging DB connection string — never committed.
supabase/staging/.connection
supabase/staging/.isolation-env

# Local staging API environment and egress log -- never committed.
supabase/staging/.api-env
supabase/staging/egress.log

# Header probe: `vercel link` inside tools/header-probe writes project metadata and a
# project-scoped VERCEL_OIDC_TOKEN. Never commit either.
tools/header-probe/.vercel
tools/header-probe/.env*

# Production audit outputs: never commit
supabase/audit/results/
