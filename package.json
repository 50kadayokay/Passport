{
  "name": "passport-v1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p src/studio/tsconfig.json",
    "check:anchors": "esbuild src/studio/dev/anchorCheck.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/studio-anchorCheck.mjs --log-level=error && node node_modules/.cache/studio-anchorCheck.mjs",
    "check:leak": "node scripts/check-prototype-leak.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:pr": "node scripts/press-release-test.mjs",
    "check:media": "node scripts/media-support-test.mjs",
    "test": "npm run check:imports && npm run check:leak && npm run check:integrity && npm run check:transcript && npm run check:failclosed && npm run check:inventory && npm run check:reconcile && npm run check:adversarial && npm run check:canonical && npm run check:auditsync && npm run check:pipeline && npm run check:pr && npm run check:media && npm run check:auth && node scripts/onboarding-classify-test.mjs",
    "check:auth": "node scripts/api-auth-test.mjs",
    "check:integrity": "node scripts/source-integrity-test.mjs",
    "check:transcript": "node scripts/transcript-test.mjs",
    "check:failclosed": "node scripts/failclosed-test.mjs",
    "check:inventory": "node scripts/ooxml-inventory-test.mjs",
    "check:reconcile": "node scripts/ooxml-reconcile-test.mjs",
    "check:adversarial": "node scripts/ooxml-adversarial-test.mjs",
    "check:canonical": "node scripts/canonical-test.mjs",
    "check:auditsync": "node scripts/audit-sync.mjs",
    "check:pipeline": "node scripts/pipeline-test.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capgo/capacitor-social-login": "^8.5.0",
    "@vercel/og": "^0.6.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^4.7.76",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sax": "^1.6.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
