# Passport environment variables
# Copy to .env for local dev, and set the same keys in Vercel (Project → Settings → Environment Variables).
# Both values are PUBLISHABLE (safe in the browser bundle). NEVER put the Supabase
# service_role / secret key in a VITE_ variable — those are inlined into the client bundle.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXX

# Google Sign-In — ANDROID (and web) audience.
# This is the *Web* OAuth client ID from Google Cloud, NOT the Android client ID.
# Android's Credential Manager mints its ID token for the Web client, so this value
# is what Supabase must accept as an audience (Auth -> Providers -> Google ->
# Authorized Client IDs, alongside the existing iOS client ID).
# The separate Android OAuth client (package name + signing SHA-1) only authorises
# the app to make the request; it is never set here.
# Like the Supabase values above this is PUBLISHABLE client configuration, not a
# secret. Never put an OAuth *client secret* in a VITE_ variable.
# Leave unset and the Google button simply stays hidden on Android.
VITE_GOOGLE_WEB_CLIENT_ID=XXXXXXXXXXXX-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
